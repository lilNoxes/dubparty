# Optional: HuggingFace token for pyannote speaker diarization (used on local PC)
HF_AUTH_TOKEN=your_huggingface_token_here

# Optional: Google Gemini API key for AI acting cues and character recognition
GEMINI_API_KEY=your_gemini_key_here

# Device for ML: 'cuda' for Nvidia RTX 3060, or 'cpu'
CUDA_DEVICE=cuda
